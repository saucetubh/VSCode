#! /opt/homebrew/Cellar/icarus-verilog/12.0/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
S_0x12f609860 .scope module, "tb_encoder32to5" "tb_encoder32to5" 2 2;
 .timescale 0 0;
v0x12f619cc0_0 .var/i "i", 31 0;
v0x12f619d70_0 .var "in", 31 0;
v0x12f619e30_0 .net "out", 4 0, v0x12f619be0_0;  1 drivers
S_0x12f6099d0 .scope module, "uut" "encoder32to5" 2 8, 3 2 0, S_0x12f609860;
 .timescale 0 0;
    .port_info 0 /INPUT 32 "in";
    .port_info 1 /OUTPUT 5 "out";
v0x12f609b40_0 .var/i "i", 31 0;
v0x12f619b40_0 .net "in", 31 0, v0x12f619d70_0;  1 drivers
v0x12f619be0_0 .var "out", 4 0;
E_0x12f609750 .event anyedge, v0x12f619b40_0;
    .scope S_0x12f6099d0;
T_0 ;
    %wait E_0x12f609750;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x12f619be0_0, 0, 5;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x12f609b40_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x12f609b40_0;
    %cmpi/s 32, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x12f619b40_0;
    %load/vec4 v0x12f609b40_0;
    %part/s 1;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x12f609b40_0;
    %pad/s 5;
    %store/vec4 v0x12f619be0_0, 0, 5;
T_0.2 ;
    %load/vec4 v0x12f609b40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x12f609b40_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x12f609860;
T_1 ;
    %vpi_call 2 16 "$dumpfile", "encoder32to5_tb.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x12f609860 {0 0 0};
    %vpi_call 2 19 "$display", "Input Position | Encoded Output" {0 0 0};
    %vpi_call 2 20 "$display", "-------------------------------" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x12f619cc0_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x12f619cc0_0;
    %cmpi/s 32, 0, 32;
    %jmp/0xz T_1.1, 5;
    %pushi/vec4 1, 0, 32;
    %load/vec4 v0x12f619cc0_0;
    %ix/vec4 4;
    %shiftl 4;
    %store/vec4 v0x12f619d70_0, 0, 32;
    %delay 5, 0;
    %vpi_call 2 26 "$display", "     %2d        |     %2d", v0x12f619cc0_0, v0x12f619e30_0 {0 0 0};
    %load/vec4 v0x12f619cc0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x12f619cc0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call 2 29 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_encoder_32to5.v";
